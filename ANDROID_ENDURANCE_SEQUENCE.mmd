sequenceDiagram
    autonumber
    actor USER as User
    participant UI as ENDURANCE Tab
    participant CTRL as EnduranceController
    participant STOCK as StockController
    participant BLE as BleClient
    participant LED as LedController
    participant A as Peripheral A
    participant B as Peripheral B
    participant FS as endurance_reports

    USER->>UI: Set cycles / waits / options
    USER->>UI: Tap Start 100 or Start Custom
    UI->>CTRL: start(settings)

    CTRL->>STOCK: ensureLoaded()
    CTRL->>STOCK: validate A/B assigned, same N, odd=A even=B
    CTRL->>CTRL: request BLE permissions

    alt validation NG
        CTRL-->>UI: status = FAILED
        CTRL-->>UI: show validation message
    else validation OK
        CTRL-->>UI: status = RUNNING
        CTRL->>STOCK: disconnectBoth()
        CTRL->>STOCK: waitForBothDisconnected()

        loop cycle = 1..N
            CTRL-->>UI: activeCycle = cycle

            opt scanBeforeConnect = ON
                CTRL->>BLE: scan(nameHint)
                BLE-->>CTRL: discovered devices
                alt expected A/B not found
                    CTRL->>CTRL: failureClass = ADV_NOT_FOUND
                    CTRL-->>UI: cycle FAIL
                end
            end

            alt scan OK
                CTRL->>STOCK: connectBoth()
                STOCK->>BLE: connect(A.id)
                STOCK->>BLE: connect(B.id)
                BLE->>A: connect
                BLE->>B: connect
                A-->>BLE: connected
                B-->>BLE: connected
                BLE-->>STOCK: connection updates
                STOCK-->>CTRL: waitForBothConnected() = true/false

                alt connect timeout
                    CTRL->>CTRL: failureClass = CONNECT_FAILED
                    CTRL-->>UI: cycle FAIL
                else connect OK
                    CTRL->>CTRL: wait connectWaitSeconds

                    opt runStartupWave = ON
                        CTRL->>LED: setOutputEnabled(A/B, true)
                        CTRL->>LED: setBrightness(A/B, ui brightness)
                        loop startup palette
                            CTRL->>LED: setTopColor(A/B, color)
                            CTRL->>LED: setBottomColor(A/B, color)
                            LED->>BLE: write command packets
                            BLE->>A: write color command
                            BLE->>B: write color command
                        end
                        alt LED write failed
                            CTRL->>CTRL: failureClass = LED_WRITE_FAIL
                            CTRL-->>UI: cycle FAIL
                        end
                    end

                    opt runGattCheck = ON
                        loop side in A, B
                            CTRL->>STOCK: readBattery(side)
                            STOCK->>BLE: read voltage characteristic
                            BLE->>A: read voltage char
                            BLE->>B: read voltage char
                            BLE-->>STOCK: battery payload
                            STOCK-->>CTRL: voltage
                            CTRL->>STOCK: verifyGattProfile(side)
                            STOCK->>BLE: discoverServices(deviceId)
                            BLE-->>STOCK: services + characteristics
                            STOCK-->>CTRL: profile result
                        end
                        alt battery/profile NG
                            CTRL->>CTRL: failureClass = GATT_TIMEOUT_OR_READ_FAIL or PROFILE_MISSING
                            CTRL-->>UI: cycle FAIL
                        end
                    end
                end
            end

            CTRL->>STOCK: disconnectBoth()
            STOCK->>BLE: cancel A/B connection streams
            BLE->>A: disconnect
            BLE->>B: disconnect
            CTRL->>CTRL: wait disconnectWaitSeconds
            CTRL->>STOCK: waitForBothDisconnected()

            alt disconnect timeout
                CTRL->>CTRL: failureClass = DISCONNECT_INCOMPLETE
            end

            CTRL->>CTRL: build EnduranceCycleRecord
            CTRL->>CTRL: update pass/fail counters and failureCounts
            CTRL-->>UI: update summary / recent cycles / logs

            alt stopOnFail = ON and cycle FAIL
                CTRL->>CTRL: break loop
            end

            alt Stop button pressed
                UI->>CTRL: stop()
                CTRL->>CTRL: _stopRequested = true
                CTRL->>CTRL: raise stop on next checkpoint
                break stop requested
            end
        end

        CTRL->>STOCK: final disconnectBoth()
        CTRL->>STOCK: waitForBothDisconnected()

        alt records exist
            CTRL->>FS: export endurance_report_timestamp.csv
            CTRL->>FS: export endurance_report_summary_timestamp.csv
            FS-->>CTRL: reportPath / summaryPath
        end

        alt normal finish
            CTRL-->>UI: status = DONE
        else stopped by user
            CTRL-->>UI: status = STOPPED
        else unexpected exception
            CTRL-->>UI: status = ERROR
        end
    end
