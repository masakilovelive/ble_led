flowchart TB
    APP["Android App\nmain.dart / BleLedApp"]
    ROOT["AppRoot"]
    SPLASH["SplashScreen\nstartup motion"]
    LOAD["StockController.ensureLoaded()"]
    STORE["LocalStore\napp_state.json"]
    AUTOCONNECT["autoConnectStored()"]
    DUAL["DualColorScreen\nTabBar: COLOR / ENDURANCE"]

    subgraph SETUP_FLOW ["Bluetooth Setup Flow"]
        SETUP["SetupScreen"]
        SCAN["ScanController.start()"]
        DISCOVER["FlutterReactiveBle.scanForDevices()"]
        FILTER["Filter by Env.nameHint"]
        ASSIGN["Assign stock A / stock B\nodd = A, even = B, same N"]
        SAVE["Persist device id, name,\nauto reconnect"]
    end

    subgraph COLOR_FLOW ["COLOR Tab Flow"]
        COLOR["COLOR tab"]
        PICKER["HSV picker / side select / syncro"]
        STARTUP["Startup Wave"]
        CONNECT["connect() / connectBoth()"]
        POSTCONNECT["Post connect\nbattery read + battery polling + resync"]
        MOTION["Heartbeat / Rainbow / Brightness / Output"]
        COMMAND["LedController + HeartbeatController"]
    end

    subgraph ENDURANCE_FLOW ["ENDURANCE Tab Flow"]
        ENDURANCE["ENDURANCE tab"]
        START["Start 100 / Start Custom"]
        VALIDATE["Validate cycles, waits,\npermissions, A/B assignment"]
        LOOP["Cycle loop x N"]
        PRECHECK["Optional scan of assigned A/B"]
        CCONNECT["connectBoth() + waitForBothConnected()"]
        CSTARTUP["Optional startup wave"]
        CGATT["Optional battery read + GATT profile check"]
        CDISCONNECT["disconnectBoth() + waitForBothDisconnected()"]
        CLASSIFY["PASS / FAIL classification\nlogs + counters + failure classes"]
        EXPORT["Export CSV reports\nendurance_report_*.csv\nendurance_report_summary_*.csv"]
        REPORTS["Documents/endurance_reports"]
    end

    subgraph BLE_RUNTIME ["BLE Runtime"]
        CLIENT["BleClient\nflutter_reactive_ble"]
        RECONNECT["Auto reconnect timer"]
        ADEV["Peripheral A"]
        BDEV["Peripheral B"]
        GATT["ADV service + command char + voltage char\nalert level char"]
    end

    APP --> ROOT --> SPLASH --> LOAD
    LOAD <--> STORE
    LOAD --> AUTOCONNECT --> DUAL

    DUAL --> SETUP
    SETUP --> SCAN --> DISCOVER --> FILTER --> ASSIGN --> SAVE --> STORE
    SAVE --> DUAL

    DUAL --> COLOR
    COLOR --> PICKER
    COLOR --> STARTUP
    COLOR --> CONNECT
    COLOR --> MOTION
    PICKER --> COMMAND
    STARTUP --> COMMAND
    MOTION --> COMMAND
    CONNECT --> CLIENT
    CLIENT --> POSTCONNECT
    POSTCONNECT --> COMMAND
    COMMAND --> CLIENT

    DUAL --> ENDURANCE
    ENDURANCE --> START --> VALIDATE --> LOOP
    VALIDATE -. uses saved A/B config .-> STORE
    LOOP --> PRECHECK --> CCONNECT --> CSTARTUP --> CGATT --> CDISCONNECT --> CLASSIFY
    CLASSIFY -->|next cycle| LOOP
    CLASSIFY -->|done or stop| EXPORT --> REPORTS

    CLIENT --> ADEV
    CLIENT --> BDEV
    ADEV --> GATT
    BDEV --> GATT
    GATT -. read / write / notify .-> CLIENT
    CLIENT -. disconnect detected .-> RECONNECT --> CONNECT
